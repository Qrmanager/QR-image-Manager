<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Gallery</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            margin: 0;
            padding: 30px;
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        .top-buttons {
            text-align: center;
            margin-bottom: 25px;
        }

        .top-buttons a {
            display: inline-block;
            padding: 10px 16px;
            margin: 5px;
            border-radius: 6px;
            text-decoration: none;
            color: white;
        }

        .upload-btn {
            background: #007bff;
        }

        .logout-btn {
            background: #dc3545;
        }

        /* Search */

        .search-box {
            text-align: center;
            margin-bottom: 30px;
        }

        .search-box input {
            padding: 12px;
            width: 280px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        .search-box button {
            padding: 12px 18px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .search-box button:hover {
            background: #0056b3;
        }

        .reset {
            margin-left: 10px;
            text-decoration: none;
            color: #666;
        }

        /* Gallery */

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: auto;
        }

        /* Card */

        .card {
            background: white;
            padding: 15px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
            text-align: center;
        }

        /* Image */

        .card img.preview {
            width: 100%;
            height: 220px;
            object-fit: contain;
            background: #f1f1f1;
            border-radius: 8px;
        }

        .card h3 {
            margin: 15px 0 5px;
            font-size: 20px;
        }

        .card p {
            color: #666;
            margin: 5px 0 15px;
        }

        /* Buttons */

        .actions {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .btn {
            display: inline-block;
            padding: 9px 18px;
            border-radius: 6px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-view {
            background: #28a745;
            color: white;
        }

        .btn-view:hover {
            background: #218838;
        }

        /* Mobile */

        @media (max-width: 600px) {

            body {
                padding: 15px;
            }

            .search-box input {
                width: 100%;
                margin-bottom: 10px;
            }

            .search-box button {
                width: 100%;
            }

            .reset {
                display: block;
                margin: 10px 0;
            }

            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <h1>Admin Gallery</h1>

    <!-- Top buttons -->

    <div class="top-buttons">

        <a href="/upload" class="upload-btn">
            ➕ Upload New Image
        </a>

        <a href="/logout" class="logout-btn">
            Logout
        </a>

    </div>


    <!-- Search -->

    <div class="search-box">

        <form action="/gallery" method="GET">
            <input
                type="text"
                name="search"
                placeholder="Search by name or ID..."
                value="<%= typeof search !== 'undefined' ? search : '' %>"
            >

            <button type="submit">
                Search
            </button>

            <a href="/gallery" class="reset">
                Reset
            </a>

        </form>

    </div>


    <!-- Gallery -->

    <div class="grid">

        <% if (images.length === 0) { %>

            <p style="grid-column: 1 / -1; text-align:center;">
                No records found.
            </p>

        <% } %>


        <% images.forEach(item => { %>

            <div class="card">

                <!-- IMPORTANT:
                     Use /image/:id instead of /uploads/:filename
                -->

                <img
                    src="/image/<%= item.id %>"
                    class="preview"
                    alt="<%= item.name %>"
                >


                <!-- Name -->

                <h3>
                    <%= item.name %>
                </h3>


                <!-- ID -->

                <p>
                    ID: <%= item.idNumber %>
                </p>


                <!-- View -->

                <div class="actions">

                    <a
                        href="/image/<%= item.id %>"
                        target="_blank"
                        class="btn btn-view"
                    >
                        👁 View
                    </a>

                </div>

            </div>

        <% }) %>

    </div>

</body>
</html>