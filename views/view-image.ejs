<!DOCTYPE html>
<html>
<head>
    <title>View Image</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 20px;
            background: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
        }
        .image-box {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 90%;
        }
        img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }
        h2 {
            margin-top: 0;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="image-box">
        <h2><%= name %></h2>
        <p>ID: <%= idNumber %></p>
        <img src="/image-file/<%= id %>" alt="Uploaded Image">
    </div>
</body>
</html>