<!DOCTYPE html>
<html>
<head>
    <title>Upload Image - QR Image Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        <h1>Upload Image</h1>
        <p>Fill in the details and select an image.</p>

        <form action="/upload" method="POST" enctype="multipart/form-data">
            
            <label>Person's Name:</label><br>
            <input type="text" name="name" required placeholder="Enter full name">
            <br><br>

            <label>ID Number:</label><br>
            <input type="text" name="idNumber" required placeholder="Enter ID number">
            <br><br>

            <label>Select Image:</label><br>
            <input type="file" name="image" accept="image/*" required>
            <br><br>

            <button type="submit">Upload & Generate QR Code</button>
        </form>

        <br><br>
        <a href="/">← Back to Home</a>
    </div>

</body>
</html>